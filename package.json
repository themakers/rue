{
  "name": "@themakers/rue",
  "version": "0.1.0",
  "description": "Vue reactivity hooks for React on web and React Native",
  "keywords": [
    "react",
    "react-native",
    "vue",
    "reactivity",
    "hooks",
    "state-management"
  ],
  "license": "MIT",
  "author": "The Makers",
  "contributors": [
    "Surmon and Veact contributors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themakers/rue.git"
  },
  "homepage": "https://github.com/themakers/rue#readme",
  "bugs": "https://github.com/themakers/rue/issues",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE",
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/rue.cjs",
  "module": "./dist/rue.js",
  "types": "./dist/rue.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rue.d.ts",
      "import": "./dist/rue.js",
      "require": "./dist/rue.cjs",
      "default": "./dist/rue.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.11.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && vite build",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.native.json --noEmit",
    "lint": "eslint src tests tests-native tests-hermes scripts examples vite.config.ts vitest.config.ts",
    "format": "prettier --write \"{src,tests,tests-native,tests-hermes,scripts,docs,examples}/**/*.{ts,tsx,js,cjs,mjs,json,md,css,yml}\" \"*.{ts,js,cjs,mjs,json,yaml}\" README.md MIGRATION.md CHANGELOG.md \".github/workflows/*.yml\"",
    "test": "pnpm test:web",
    "test:web": "vitest run",
    "test:native": "jest --config jest.config.cjs --runInBand",
    "test:hermes": "node scripts/hermes-smoke.mjs",
    "examples:check": "pnpm --filter @rue/example-web build && pnpm --filter @rue/example-expo typecheck && pnpm --filter @rue/example-expo-rsd typecheck",
    "examples:bundle": "pnpm --filter @rue/example-expo bundle && pnpm --filter @rue/example-expo-rsd bundle",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "check:platform": "node scripts/check-platform.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:native && pnpm test:hermes && pnpm build && pnpm check:platform && pnpm check:size && pnpm check:package && pnpm pack:smoke && pnpm examples:check && pnpm examples:bundle",
    "prepack": "pnpm build && pnpm check:platform && pnpm check:size && pnpm check:package"
  },
  "peerDependencies": {
    "@vue/reactivity": "^3.5.0",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@babel/core": "7.29.7",
    "@microsoft/api-extractor": "^7.58.12",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/reactivity": "3.5.41",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "esbuild": "^0.28.2",
    "expo": "~57.0.12",
    "globals": "^17.10.0",
    "hermes-compiler": "250829098.0.2",
    "jsdom": "^30.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
